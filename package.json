{
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun -F '*' --parallel dev",
    "build": "bun -F '*' --parallel build",
    "docker:local": "docker build --build-arg ENV_FILE=.env.production.local -t bunext .",
    "docker:deploy": "docker build --build-arg ENV_FILE=.env.deploy -t bunext .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit",
    "all": "bun run format:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "6.0.3"
  }
}
