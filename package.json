{
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun -F '*' --parallel dev",
    "build": "bun -F '*' --parallel build",
    "docker:local": "docker build --build-arg ENV_FILE=.env.production.local -t bunext .",
    "docker:deploy": "docker build --build-arg ENV_FILE=.env.deploy -t bunext .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "bun check",
    "warden": "warden",
    "all": "bun run format:check && bun run lint && bun run typecheck && bun run warden"
  },
  "devDependencies": {
    "@verekia/warden": "0.0.6",
    "oxlint": "1.63.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
