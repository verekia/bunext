{
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun -F '*' --parallel dev",
    "build": "bun -F '*' --parallel build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "bun -F server migrate",
    "docker:local": "docker build --build-arg ENV_FILE=.env.production.local -t bunext .",
    "docker:deploy": "docker build --build-arg ENV_FILE=.env.deploy -t bunext .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "all": "bun format:check && bun lint"
  },
  "devDependencies": {
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "typescript": "6.0.3"
  }
}
