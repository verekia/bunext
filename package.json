{
  "private": true,
  "workspaces": [
    "frontend",
    "api"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun -F '*' --parallel dev",
    "build": "bun -F '*' --parallel build",
    "start": "bun -F '*' --parallel start",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "all": "bun format:check && bun lint"
  },
  "devDependencies": {
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "typescript": "6.0.3"
  }
}
